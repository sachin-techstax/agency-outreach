SERPER_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
YOUR_NAME="Sachin Rajan"
PORTFOLIO_URL=
CALENDLY_URL=
MIN_SCORE=70
DISCOVERY_LIMIT=15
FOLLOWUP_DAYS=4
# Host/local-Python defaults. Docker Compose overrides these with /data and
# /secrets paths inside the containers.
DB_PATH=agency_outreach.db
GMAIL_CLIENT_SECRET=client_secret.json
GMAIL_TOKEN_FILE=token.json
LOG_LEVEL=INFO
LOG_FILE=

# PactSignal operator UI. Demo mode serves fictional data and blocks every
# persistent/external action (pipeline runs, Gmail drafts, status mutations).
PACTSIGNAL_DEMO_MODE=false

# PactSignal application authentication.
# Production should enable this and supply a bcrypt password hash plus a
# high-entropy JWT signing secret. The JWT is stored only in an HttpOnly,
# Secure, SameSite=Strict cookie.
PACTSIGNAL_AUTH_ENABLED=false
PACTSIGNAL_ADMIN_USERNAME=sachin
PACTSIGNAL_ADMIN_PASSWORD_HASH=
PACTSIGNAL_JWT_SECRET=
PACTSIGNAL_JWT_TTL_MINUTES=480
PACTSIGNAL_COOKIE_SECURE=true
PACTSIGNAL_LOGIN_MAX_FAILURES=5
PACTSIGNAL_LOGIN_WINDOW_SECONDS=300

# Optional Docker file-ownership overrides for Linux hosts.
LOCAL_UID=1000
LOCAL_GID=1000
