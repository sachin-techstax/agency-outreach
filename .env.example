SERPER_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
YOUR_NAME="Sachin Rajan"
PORTFOLIO_URL=
CALENDLY_URL=
MIN_SCORE=70
DISCOVERY_LIMIT=15
FOLLOWUP_DAYS=4
# Host/local-Python defaults. Docker Compose overrides these with /data and
# /secrets paths inside the containers.
DB_PATH=nuntago.db
GMAIL_CLIENT_SECRET=client_secret.json
GMAIL_TOKEN_FILE=token.json
LOG_LEVEL=INFO
LOG_FILE=

# Nuntago operator UI. Demo mode serves fictional data and blocks every
# persistent/external action (pipeline runs, Gmail drafts, status mutations).
NUNTAGO_DEMO_MODE=false

# Nuntago browser surfaces.
# Public host always uses the isolated fictional /api/public/* showcase API.
# Operator host is intended to sit behind Cloudflare Access.
NUNTAGO_PUBLIC_HOST=nuntago-demo.ergorum.com
NUNTAGO_OPERATOR_HOST=nuntago.ergorum.com

# Operator API authentication.
# Production browser auth should use Cloudflare Access. The bearer token is an
# optional fallback for CLI/local automation and is never entered in the UI.
NUNTAGO_AUTH_ENABLED=false
NUNTAGO_API_TOKEN=
NUNTAGO_ACCESS_TEAM_DOMAIN=
NUNTAGO_ACCESS_AUD=
NUNTAGO_OPERATOR_EMAIL=

# Optional Docker file-ownership overrides for Linux hosts.
LOCAL_UID=1000
LOCAL_GID=1000
