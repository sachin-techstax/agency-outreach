# Search provider
SERPER_API_KEY=

# LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Outreach identity
YOUR_NAME=Sachin Rajan
PORTFOLIO_URL=
CALENDLY_URL=

# Pipeline
MIN_SCORE=70
DISCOVERY_LIMIT=15
FOLLOWUP_DAYS=4

# Local Python defaults. Docker Compose overrides these with /data and /secrets paths.
DB_PATH=agency_outreach.db
GMAIL_CLIENT_SECRET=client_secret.json
GMAIL_TOKEN_FILE=token.json

# Observability
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR (default: INFO)
LOG_LEVEL=INFO
# LOG_FILE: optional rotating log file. Blank = console only.
# Inside Docker, /data is mounted from ./data on the host.
LOG_FILE=

# Docker file ownership on Linux. Change if your host UID/GID are different.
LOCAL_UID=1000
LOCAL_GID=1000
